# 실제 값은 .env에 넣는다 (.env는 커밋하지 않는다).

# OpenRouter — LLM 라우팅용
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=minimax/minimax-m3:free

# 판정 이력 DB 경로 (기본: doc-validator/data/judgements.db)
JUDGEMENT_DB_PATH=

# 컨테이너 빌드 시 주입하는 빌드 메타 (로컬에서는 .git에서 읽는다)
GIT_COMMIT=
GIT_BRANCH=
