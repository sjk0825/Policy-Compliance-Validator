__pycache__/
*.py[cod]
.venv/
venv/

# 판정 이력 DB (런타임 데이터)
doc-validator/data/*.db

# 시세 fixture. 재생성 가능하므로 커밋하지 않는다.
# 무엇을 언제 어디까지 받았는지는 fixtures/manifest.json이 기록한다.
doc-validator/fixtures/data/
# 슬라이스 CSV도 seed로 복원 가능하다. slice.json만 커밋한다.
doc-validator/fixtures/slices/**/*.csv

# 라우터 입력 fixture. 케이스 정의(router_cases.json)로 재생성되므로
# 내용은 커밋하지 않고 해시가 담긴 manifest만 남긴다.
doc-validator/fixtures/router_inputs/*.json
!doc-validator/fixtures/router_inputs/manifest.json

# 백테스트 원자료. 요약(_summary.json)만 커밋한다.
doc-validator/fixtures/backtests/*_heuristic.json
doc-validator/fixtures/backtests/*_llm_sample.json
doc-validator/logs/*.log

.env
*.deb
